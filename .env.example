# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Segredo de assinatura dos tokens de sessao. TROQUE por 64 chars aleatorios.
JWT_SECRET=troque-este-valor-por-uma-string-aleatoria-longa
# Usuario administrador criado no primeiro boot
ADMIN_EMAIL=lucas.monteiro@fluxodigitaltech.com.br
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Lucas Monteiro

# ─── Banco de dados (EasyPanel cria isto por voce) ───────────────────────────
DATABASE_URL=postgres://usuario:senha@host:5432/enotel_parity
# 'require' quando o Postgres estiver fora da rede interna do EasyPanel
PGSSLMODE=disable

# ─── SerpAPI (Google Hotels) ─────────────────────────────────────────────────
SERPAPI_KEY=1c89f17984f1158bb7b026ac664c41c983e8219e0c75bc7194841eb8ae4719af
# Teto duro de requisicoes por mes. O scanner ABORTA antes de furar isso.
SERPAPI_MONTHLY_LIMIT=250
# Reserva de emergencia: requisicoes que so o disparo manual pode consumir
SERPAPI_RESERVE=25

# ─── uazapi (WhatsApp) ───────────────────────────────────────────────────────
# Ex.: https://sua-instancia.uazapi.com  (sem barra no final)
UAZAPI_URL=
# Token de administrador do servidor uazapi (cria/lista instancias)
UAZAPI_ADMIN_TOKEN=
# Token da instancia ja criada. Deixe vazio para criar pela interface.
UAZAPI_INSTANCE_TOKEN=

# ─── Agendamento ─────────────────────────────────────────────────────────────
# Varredura diaria. Padrao: 06:10 no horario de Recife.
SCAN_CRON=10 6 * * *
SCAN_TIMEZONE=America/Recife
# Ligue apenas em UMA instancia se rodar replicas
SCHEDULER_ENABLED=true
